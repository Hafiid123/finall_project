@model online_mr_certi.Models.ViewModels.PaymentCheckoutViewModel
@{
    ViewData["Title"] = "Payment checkout";
}

<style>
    /* ── PAGE HEADER ── */
    .pay-header {
        margin-bottom: 24px;
        animation: fade-up 0.5s ease both;
    }

        .pay-header p {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: #2F80ED;
            margin-bottom: 6px;
        }

        .pay-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(22px, 3vw, 32px);
            color: #1a2742;
            font-weight: 700;
            margin: 0 0 4px;
        }

        .pay-header .pay-app-id {
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            color: #94a3b8;
        }

    /* ── CARDS ── */
    .pay-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid #e8eef8;
        box-shadow: 0 2px 16px rgba(30,102,208,0.07);
        overflow: hidden;
        margin-bottom: 22px;
        animation: fade-up 0.5s ease 0.05s both;
    }

    .pay-card-header {
        padding: 16px 24px;
        border-bottom: 1px solid #f1f5f9;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #1a2742;
        background: #f8fafd;
    }

        .pay-card-header.header-accent {
            background: #2F80ED;
            color: #fff;
            text-transform: none;
            font-size: 14.5px;
            letter-spacing: 0.2px;
        }

    .pay-card.accent-primary {
        border: 1.5px solid #2F80ED;
    }

    .pay-card-body {
        padding: 22px 24px;
        font-family: 'DM Sans', sans-serif;
    }

    .pay-row {
        margin-bottom: 6px;
        font-size: 14px;
        color: #333333;
    }

        .pay-row strong {
            color: #1a2742;
            font-weight: 600;
        }

    /* ── PAYMENT INSTRUCTIONS ── */
    .pay-number-label {
        font-size: 13.5px;
        color: #1a2742;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .pay-number-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        background: #1a2742;
        color: #fff;
        border-radius: 12px;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 18px;
        font-family: 'DM Sans', sans-serif;
    }

    .pay-steps {
        margin: 0;
        padding-left: 20px;
        font-size: 13.5px;
        color: #333333;
        line-height: 1.8;
    }

        .pay-steps li strong {
            color: #1a2742;
        }

        .pay-steps li code {
            background: #eef3fc;
            color: #1E66D0;
            padding: 2px 8px;
            border-radius: 6px;
            font-size: 13px;
        }

    /* ── ALERT ── */
    .pay-alert {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px 20px;
        border-radius: 14px;
        margin-bottom: 22px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13.5px;
        line-height: 1.55;
        background: #fffbeb;
        border: 1.5px solid #fcd34d;
        color: #92400e;
        animation: fade-up 0.4s ease both;
    }

    .pay-alert-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #fef3c7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .pay-alert strong {
        display: block;
        margin-bottom: 2px;
        font-weight: 700;
    }

    /* ── FORM ── */
    .pay-form-group {
        margin-bottom: 18px;
    }

    .pay-label {
        display: block;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        color: #475569;
        margin-bottom: 7px;
        font-family: 'DM Sans', sans-serif;
    }

    .pay-input {
        width: 100%;
        padding: 12px 16px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-size: 14px;
        font-family: 'DM Sans', sans-serif;
        color: #1a2742;
        background: #fff;
        transition: all 0.2s;
        box-sizing: border-box;
    }

        .pay-input:focus {
            outline: none;
            border-color: #2F80ED;
            box-shadow: 0 0 0 3px rgba(47,128,237,0.12);
        }

        .pay-input::placeholder {
            color: #b8c4d6;
        }

    .pay-hint {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 6px;
    }

    .pay-error {
        font-size: 12px;
        color: #ef4444;
        margin-top: 4px;
        display: block;
    }

    .validation-summary-errors {
        font-size: 13px;
        color: #ef4444;
        margin-bottom: 14px;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

    /* ── BUTTONS ── */
    .btn-pay-submit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 26px;
        background: #10b981;
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(16,185,129,0.28);
        transition: all 0.25s;
    }

        .btn-pay-submit:hover {
            background: #059669;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(16,185,129,0.38);
            color: #fff;
        }

    .btn-pay-cancel {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 22px;
        background: #fff;
        color: #64748b;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        text-decoration: none;
        margin-left: 10px;
        transition: all 0.2s;
    }

        .btn-pay-cancel:hover {
            background: #f8fafd;
            color: #475569;
            border-color: #cbd5e1;
        }

    .pay-divider-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 28px 0 22px;
    }

    .pay-divider-line {
        flex: 1;
        height: 1px;
        background: #f1f5f9;
    }

    .pay-divider-text {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #c7d7f0;
    }

    .pay-office-text {
        font-size: 14px;
        color: #1a2742;
        margin-bottom: 12px;
    }

        .pay-office-text strong {
            font-weight: 700;
        }

    .btn-pay-office {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 22px;
        background: #fff;
        color: #1E66D0;
        border: 1.5px solid #c7d7f0;
        border-radius: 12px;
        font-size: 13.5px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-pay-office:hover {
            background: #eef3fc;
            border-color: #1E66D0;
        }

    /* ── ANIMATIONS ── */
    @@keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<!-- HEADER -->
<div class="pay-header">
    <p>💳 Checkout</p>
    <h2>Payment checkout</h2>
    <p class="pay-app-id">Application #@Model.ApplicationId</p>
</div>

<!-- PAYMENT DETAILS -->
<div class="pay-card">
    <div class="pay-card-header"><i class="fas fa-file-invoice-dollar me-2"></i>Payment details</div>
    <div class="pay-card-body">
        <p class="pay-row"><strong>Fee:</strong> @Model.FeeName</p>
        <p class="pay-row mb-0"><strong>Amount:</strong> @Model.Amount.ToString("N2") @Model.Currency</p>
    </div>
</div>

<!-- PAYMENT INSTRUCTIONS -->
<div class="pay-card accent-primary">
    <div class="pay-card-header header-accent"><i class="fas fa-mobile-alt me-2"></i>Payment instructions</div>
    <div class="pay-card-body">
        <p class="pay-number-label">Send to this number:</p>
        <div class="pay-number-badge"><i class="fas fa-phone"></i> @Model.MobileMoneyNumber</div>
        <ol class="pay-steps">
            <li>Open <strong>EVC Plus</strong>, <strong>ZAAD</strong>, or your mobile money app.</li>
            <li>Send the <strong>exact amount</strong> shown above to the number displayed.</li>
            <li><code>*712*61XXXXXX</code></li>
            <li>Keep the receipt screenshot or photo — you will upload it below.</li>
        </ol>
    </div>
</div>

<!-- WARNING ALERT -->
<div class="pay-alert">
    <div class="pay-alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
    <div>
        <strong>Important</strong>
        Enter your transaction details carefully. Your payment will be verified by an administrator before your application proceeds.
    </div>
</div>

<!-- SUBMIT PROOF FORM -->
<div class="pay-card mb-0">
    <div class="pay-card-header"><i class="fas fa-receipt me-2"></i>Submit payment proof</div>
    <div class="pay-card-body">
        <form asp-action="Checkout" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ApplicationId" />
            <input type="hidden" asp-for="FeeName" />
            <input type="hidden" asp-for="Amount" />
            <input type="hidden" asp-for="Currency" />
            <input type="hidden" asp-for="MobileMoneyNumber" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="pay-form-group">
                <label asp-for="SenderPhone" class="pay-label"></label>
                <input asp-for="SenderPhone" class="pay-input" autocomplete="tel" placeholder="Phone used to send payment" />
                <span asp-validation-for="SenderPhone" class="pay-error"></span>
            </div>

            <div class="pay-form-group">
                <label asp-for="TransactionNumber" class="pay-label"></label>
                <input asp-for="TransactionNumber" class="pay-input" placeholder="Reference / transaction ID from SMS or receipt" />
                <span asp-validation-for="TransactionNumber" class="pay-error"></span>
            </div>

            <div class="pay-form-group">
                <label asp-for="ReceiptImage" class="pay-label"></label>
                <input asp-for="ReceiptImage" class="pay-input" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                <span asp-validation-for="ReceiptImage" class="pay-error"></span>
                <div class="pay-hint">JPG, JPEG, or PNG only (max 10 MB).</div>
            </div>

            <button type="submit" class="btn-pay-submit"><i class="fas fa-check"></i> Submit payment proof</button>
            <a asp-action="Details" asp-route-id="@Model.ApplicationId" class="btn-pay-cancel">Cancel</a>
        </form>

        <div class="pay-divider-wrap">
            <div class="pay-divider-line"></div>
            <span class="pay-divider-text">Or</span>
            <div class="pay-divider-line"></div>
        </div>

        <form asp-action="PayAtOffice" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.ApplicationId" />
            <p class="pay-office-text"><strong>Or pay at the office</strong> when you visit for your appointment.</p>
            <button type="submit" class="btn-pay-office"><i class="fas fa-building"></i> I will pay at the office</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
