@model online_mr_certi.Models.MarriageApplication
@using online_mr_certi.Models
@using online_mr_certi.Infrastructure
@{
    ViewData["Title"] = "Application #" + Model.Id;
    var pay = Model.Payment;
    var waitingVerification = pay != null &&
        pay.PaymentStatus == PaymentStatuses.Pending &&
        !string.IsNullOrEmpty(pay.ReceiptImage);
    var showPayNow = pay != null &&
        pay.PaymentStatus != PaymentStatuses.Approved &&
        !waitingVerification &&
        pay.TransactionNumber != PaymentMethods.PayAtOfficeMarker;
    var canBook = AppointmentWorkflow.CanBookAppointment(Model, pay);

    string Show(string? value) => string.IsNullOrWhiteSpace(value) || value == "—" ? "—" : value;
    Document? Doc(string cat) => Model.Documents.FirstOrDefault(d => d.Category == cat);
}

<style>
    /* ── PAGE HEADER ── */
    .det-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
        animation: fade-up 0.5s ease both;
    }

    .det-header-left p {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #2F80ED;
        margin-bottom: 6px;
    }

    .det-header-left h2 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(22px, 3vw, 32px);
        color: #1a2742;
        font-weight: 700;
        margin: 0;
    }

        .det-header-left h2 span {
            color: #2F80ED;
        }

    .det-header-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 18px;
        background: #fff;
        color: #1E66D0;
        border: 1.5px solid #c7d7f0;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-back-link:hover {
            background: #eef3fc;
            border-color: #1E66D0;
            color: #1E66D0;
        }

    /* ── STATUS BADGE (reused style) ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        border-radius: 100px;
        font-size: 12px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        white-space: nowrap;
    }

        .status-badge .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex-shrink: 0;
        }

    .badge-pending-payment {
        background: #f1f5f9;
        color: #475569;
    }

        .badge-pending-payment .dot {
            background: #94a3b8;
        }

    .badge-pending {
        background: #fffbeb;
        color: #b45309;
    }

        .badge-pending .dot {
            background: #f59e0b;
        }

    .badge-approved {
        background: #ecfdf5;
        color: #065f46;
    }

        .badge-approved .dot {
            background: #10b981;
        }

    .badge-rejected {
        background: #fef2f2;
        color: #991b1b;
    }

        .badge-rejected .dot {
            background: #ef4444;
        }

    .badge-info {
        background: #eef3fc;
        color: #1E66D0;
    }

        .badge-info .dot {
            background: #2F80ED;
        }

    .badge-primary {
        background: #e8f0fe;
        color: #1d4ed8;
    }

        .badge-primary .dot {
            background: #3b82f6;
        }

    /* ── ALERTS ── */
    .det-alert {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px 20px;
        border-radius: 14px;
        margin-bottom: 20px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13.5px;
        line-height: 1.55;
        animation: fade-up 0.4s ease both;
    }

    .det-alert-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .det-alert-success {
        background: #ecfdf5;
        border: 1.5px solid #6ee7b7;
        color: #065f46;
    }

        .det-alert-success .det-alert-icon {
            background: #d1fae5;
        }

    .det-alert-danger {
        background: #fef2f2;
        border: 1.5px solid #fca5a5;
        color: #991b1b;
    }

        .det-alert-danger .det-alert-icon {
            background: #fee2e2;
        }

    .det-alert-warning {
        background: #fffbeb;
        border: 1.5px solid #fcd34d;
        color: #92400e;
    }

        .det-alert-warning .det-alert-icon {
            background: #fef3c7;
        }

    .det-alert-info {
        background: #eef3fc;
        border: 1.5px solid #bfdbfe;
        color: #1e3a8a;
    }

        .det-alert-info .det-alert-icon {
            background: #dbeafe;
            color: #1E66D0;
        }

    .det-alert strong {
        display: block;
        margin-bottom: 2px;
        font-weight: 700;
    }

    .alert-link-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 10px;
        padding: 7px 16px;
        background: #fff;
        color: #1E66D0;
        border: 1.5px solid #c7d7f0;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }

        .alert-link-btn:hover {
            background: #1E66D0;
            border-color: #1E66D0;
            color: #fff;
        }

    /* ── CARDS ── */
    .det-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid #e8eef8;
        box-shadow: 0 2px 16px rgba(30,102,208,0.07);
        overflow: hidden;
        margin-bottom: 24px;
        animation: fade-up 0.5s ease 0.05s both;
    }

        /* .det-card.accent-success {
            border-left: 4px solid #10b981;
        } */

        .det-card.accent-danger {
            border-left: 4px solid #ef4444;
        }

        .det-card.accent-warning {
            border-left: 4px solid #f59e0b;
        }

        .det-card.accent-primary {
            border-left: 4px solid #2F80ED;
        }

    .det-card-header {
        padding: 18px 24px;
        border-bottom: 1px solid #f1f5f9;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #1a2742;
        background: #f8fafd;
    }

    .det-card-body {
        padding: 22px 24px;
        font-family: 'DM Sans', sans-serif;
    }

    .det-row {
        margin-bottom: 8px;
        font-size: 14px;
        color: #333333;
    }

        .det-row strong {
            color: #1a2742;
            font-weight: 600;
        }

    .det-muted {
        color: #94a3b8;
        font-size: 12.5px;
    }

    .det-link {
        color: #1E66D0;
        font-weight: 600;
        text-decoration: none;
    }

        .det-link:hover {
            text-decoration: underline;
        }

    .det-divider {
        height: 1px;
        background: #f1f5f9;
        margin: 14px 0;
        border: none;
    }

    .btn-pay-now {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        background: #10b981;
        color: #fff;
        border-radius: 10px;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 2px 8px rgba(16,185,129,0.25);
        transition: all 0.2s;
    }

        .btn-pay-now:hover {
            background: #059669;
            color: #fff;
            transform: translateY(-1px);
        }

    /* ── PERSON CARDS (Husband/Wife) ── */
    .person-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    @@media (max-width: 768px) {
        .person-grid {
            grid-template-columns: 1fr;
        }
    }

    .info-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .info-list li {
            padding: 13px 24px;
            border-bottom: 1px solid #f5f7fb;
            font-size: 14px;
        }

            .info-list li:last-child {
                border-bottom: none;
            }

            .info-list li strong {
                display: block;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.8px;
                text-transform: uppercase;
                color: #94a3b8;
                margin-bottom: 3px;
            }

    /* ── WITNESS GRID ── */
    .witness-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    @@media (max-width: 768px) {
        .witness-grid {
            grid-template-columns: 1fr;
        }
    }

    .witness-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #2F80ED;
        margin-bottom: 10px;
    }

    .witness-fields {
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .witness-fields li {
            margin-bottom: 10px;
            font-size: 13.5px;
        }

            .witness-fields li strong {
                display: block;
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: 0.6px;
                text-transform: uppercase;
                color: #94a3b8;
                margin-bottom: 2px;
            }

    /* ── DOCUMENTS LIST ── */
    .doc-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .doc-list li {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px 24px;
            border-bottom: 1px solid #f5f7fb;
            font-size: 13.5px;
        }

            .doc-list li:last-child {
                border-bottom: none;
            }

    .doc-icon {
        width: 30px;
        height: 30px;
        background: #eef3fc;
        color: #2F80ED;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        flex-shrink: 0;
    }

    /* ── ANIMATIONS ── */
    @@keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<!-- HEADER -->
<div class="det-header">
    <div class="det-header-left">
        <p>📄 Application Details</p>
        <h2>Application <span>#@Model.Id</span></h2>
    </div>
    <div class="det-header-right">
        @if (Model.Status == ApplicationStatus.PendingPayment)
        {
            <span class="status-badge badge-pending-payment"><span class="dot"></span>Pending Payment</span>
        }
        else if (Model.Status == ApplicationStatus.AwaitingAppointment)
        {

            <span class="status-badge badge-info"><span class="dot"></span>Awaiting appointment</span>
        }
        else if (Model.Status == ApplicationStatus.AppointmentBooked)
        {

            <span class="status-badge badge-primary"><span class="dot"></span>Appointment booked</span>
        }
        else if (Model.Status == ApplicationStatus.CorrectionRequired)
        {

            <span class="status-badge badge-rejected"><span class="dot"></span>Correction required</span>
        }
        else if (Model.Status == ApplicationStatus.Pending)
        {

            <span class="status-badge badge-pending"><span class="dot"></span>Pending review</span>
        }
        else if (Model.Status == ApplicationStatus.Approved)
        {

            <span class="status-badge badge-approved"><span class="dot"></span>Approved</span>
        }
        else
        {

            <span class="status-badge badge-rejected"><span class="dot"></span>Rejected</span>
        }
    </div>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="det-alert det-alert-success">
        <div class="det-alert-icon"><i class="fas fa-check-circle"></i></div>
        <div>@msg</div>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="det-alert det-alert-danger">
        <div class="det-alert-icon"><i class="fas fa-times-circle"></i></div>
        <div>@err</div>
    </div>
}

@if (pay != null)
{
    var accentClass = pay.PaymentStatus == PaymentStatuses.Approved ? "accent-success"
        : pay.PaymentStatus == PaymentStatuses.Rejected ? "accent-danger" : "accent-warning";

    <div class="det-card @accentClass">
        <div class="det-card-header"><i class="fas fa-credit-card me-2"></i>Fee payment</div>
        <div class="det-card-body">
            @if (pay.Fee != null)
            {
                <p class="det-row"><strong>Fee:</strong> @pay.Fee.ServiceName</p>
            }
            <p class="det-row"><strong>Amount:</strong> @pay.Amount.ToString("N2") @(pay.Fee?.Currency ?? "")</p>
            <p class="det-row"><strong>Payment status:</strong> @pay.PaymentStatus</p>
            @if (!string.IsNullOrEmpty(pay.SenderPhone))
            {
                <p class="det-row det-muted"><strong>Sender phone:</strong> @pay.SenderPhone</p>
            }
            @if (!string.IsNullOrEmpty(pay.TransactionNumber))
            {
                <p class="det-row det-muted"><strong>Transaction #:</strong> @pay.TransactionNumber</p>
            }

            @if (waitingVerification)
            {
                <p class="det-muted mt-2 mb-2">Your payment proof was received and is awaiting administrator verification.</p>
                @if (!string.IsNullOrEmpty(pay.ReceiptImage))
                {
                    <a target="_blank" href="~/@pay.ReceiptImage" class="det-link"><i class="fas fa-image me-1"></i>View uploaded receipt</a>
                }
            }
            else if (pay.PaymentStatus == PaymentStatuses.Approved)
            {
                <p class="det-row" style="color:#10b981;font-weight:600;font-size:13px;">Payment verified.</p>
            }
            else if (pay.TransactionNumber == PaymentMethods.PayAtOfficeMarker)
            {
                <p class="det-row" style="color:#2F80ED;font-weight:600;font-size:13px;">You selected pay-at-office. Bring payment when you visit.</p>
            }
            else if (pay.PaymentStatus == PaymentStatuses.Rejected)
            {
                <p class="det-row" style="color:#ef4444;font-weight:600;font-size:13px;">Your payment could not be verified. Please submit new payment details.</p>
            }

            @if (showPayNow)
            {
                <hr class="det-divider" />
                <a asp-action="Checkout" asp-route-id="@Model.Id" class="btn-pay-now">
                    <i class="fas fa-credit-card"></i> Pay now
                </a>
            }
        </div>
    </div>
}

@if (Model.Status == ApplicationStatus.Approved && Model.CertificateFeeStatus != null)
{
    var certAccent = Model.CertificateFeeStatus == CertificateFeeStatuses.Paid ? "accent-success"
        : Model.CertificateFeeStatus == CertificateFeeStatuses.Rejected ? "accent-danger" : "accent-warning";
    <div class="det-card @certAccent">
        <div class="det-card-header"><i class="fas fa-file-invoice me-2"></i>Certificate Fee</div>
        <div class="det-card-body">
            <p class="det-row"><strong>Amount:</strong> @(Model.CertificateFeeAmount?.ToString("N2") ?? "—")</p>
            <p class="det-row"><strong>Status:</strong>
                @if (Model.CertificateFeeStatus == CertificateFeeStatuses.Paid)
                { <span class="badge badge-success">Paid</span> }
                else if (Model.CertificateFeeStatus == CertificateFeeStatuses.Rejected)
                { <span class="badge badge-danger">Rejected</span> }
                else
                { <span class="badge badge-warning">Pending</span> }
            </p>
            @if (!string.IsNullOrEmpty(Model.CertificateFeeSenderPhone))
            {
                <p class="det-row det-muted"><strong>Sender phone:</strong> @Model.CertificateFeeSenderPhone</p>
            }
            @if (!string.IsNullOrEmpty(Model.CertificateFeeTransactionNumber))
            {
                <p class="det-row det-muted"><strong>Transaction #:</strong> @Model.CertificateFeeTransactionNumber</p>
            }
            @if (!string.IsNullOrEmpty(Model.CertificateFeeReceiptImage))
            {
                <a target="_blank" href="~/@Model.CertificateFeeReceiptImage" class="det-link"><i class="fas fa-image me-1"></i>View receipt</a>
            }
            @if (Model.CertificateFeeStatus != CertificateFeeStatuses.Paid)
            {
                <hr class="det-divider" />
                <form asp-action="SubmitCertificatePayment" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="form-group">
                        <label>Phone number used to send payment</label>
                        <input type="text" name="senderPhone" class="form-control" placeholder="E.g. 612345678" required />
                    </div>
                    <div class="form-group">
                        <label>Transaction number</label>
                        <input type="text" name="transactionNumber" class="form-control" placeholder="Reference / transaction ID" required />
                    </div>
                    <button type="submit" class="btn-pay-now"><i class="fas fa-credit-card"></i> Submit certificate fee payment</button>
                </form>
            }
            @if (Model.CertificateFeeStatus == CertificateFeeStatuses.Paid)
            {
                <p class="det-row" style="color:#10b981;font-weight:600;font-size:13px;">Certificate fee paid. Certificate is ready.</p>
            }
        </div>
    </div>
}

@if (Model.Appointment != null && Model.Appointment.Status == AppointmentStatuses.Booked)
{
    <div class="det-card accent-primary">
        <div class="det-card-header"><i class="fas fa-calendar-check me-2"></i>Your appointment</div>
        <div class="det-card-body">
            <p class="det-row"><strong>Reference:</strong> <code>@Model.Appointment.ReferenceNumber</code></p>
            <p class="det-row"><strong>Date:</strong> @Model.Appointment.AppointmentDate.ToString("dddd, dd MMM yyyy")</p>
            <p class="det-row mb-0"><strong>Time:</strong> @Model.Appointment.TimeSlot.StartTime.ToString("HH:mm") – @Model.Appointment.TimeSlot.EndTime.ToString("HH:mm")</p>
            <p class="det-muted mt-2 mb-0">Bring original ID documents for both parties. Certificates are printed at the office after verification — not available for online download.</p>
        </div>
    </div>
}
else if (Model.AppointmentDate != null)
{
    <div class="det-card accent-primary">
        <div class="det-card-header"><i class="fas fa-calendar-check me-2"></i>Appointment</div>
        <div class="det-card-body">
            <p class="det-row"><strong>Date:</strong> @Model.AppointmentDate.Value.ToString("dddd, dd MMM yyyy")</p>
            <p class="det-row"><strong>Time:</strong> @(string.IsNullOrEmpty(Model.AppointmentTime) ? "—" : Model.AppointmentTime)</p>
            <p class="det-row"><strong>Status:</strong>
                @if (Model.AppointmentStatus == AppointmentSimpleStatuses.Pending)
                { <span class="badge badge-warning">Pending</span> }
                else if (Model.AppointmentStatus == AppointmentSimpleStatuses.Confirmed)
                { <span class="badge badge-info">Confirmed</span> }
                else if (Model.AppointmentStatus == AppointmentSimpleStatuses.Completed)
                { <span class="badge badge-success">Completed</span> }
                else if (Model.AppointmentStatus == AppointmentSimpleStatuses.Cancelled)
                { <span class="badge badge-danger">Cancelled</span> }
                else
                { <span class="text-muted">@Model.AppointmentStatus</span> }
            </p>
        </div>
    </div>
}
else if (canBook)
{
    <div class="det-card accent-info">
        <div class="det-card-header"><i class="fas fa-calendar-plus me-2"></i>Book Appointment</div>
        <div class="det-card-body">
            <p class="text-muted">Choose a date and time for your office visit.</p>
            <form asp-controller="Applications" asp-action="BookAppointment" method="post" class="form-inline mb-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="form-group mr-2 mb-1">
                    <label class="sr-only" for="appDate">Date</label>
                    <input type="date" name="appointmentDate" class="form-control" placeholder="Date" required />
                </div>
                <div class="form-group mr-2 mb-1">
                    <label class="sr-only" for="appTime">Time</label>
                    <input type="text" name="appointmentTime" class="form-control" placeholder="Time (e.g. 10:00)" required />
                </div>
                <button type="submit" class="btn btn-primary mb-1">Book appointment</button>
            </form>
            <hr />
            <p class="mb-0 small">
                <a asp-controller="Appointments" asp-action="Book" asp-route-applicationId="@Model.Id">
                    Or book with a scheduled time slot
                </a>
            </p>
        </div>
    </div>
}

@if (Model.Status == ApplicationStatus.Approved && pay != null && pay.PaymentStatus != PaymentStatuses.Approved)
{
    <div class="det-alert det-alert-warning">
        <div class="det-alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div>
            <strong>Payment required</strong>
            Your certificate cannot be generated or printed until your payment is approved. Please complete your payment.
        </div>
    </div>
}

@if (Model.Status == ApplicationStatus.Approved)
{
    <div class="det-alert det-alert-success">
        <div class="det-alert-icon"><i class="fas fa-check-circle"></i></div>
        <div>
            Your application was approved at the office.
            @if (Model.CertificateFeeStatus != CertificateFeeStatuses.Paid)
            {
                <span>Please pay the certificate fee above to proceed with certificate processing.</span>
            }
            else
            {
                <span>Certificate fee paid. Collect your printed certificate from the court.</span>
            }
        </div>
    </div>
}
else if (Model.Status == ApplicationStatus.CorrectionRequired && !string.IsNullOrEmpty(Model.Remarks))
{
    <div class="det-alert det-alert-warning">
        <div class="det-alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div>
            <strong>Correction required</strong>
            @Model.Remarks
            @if (canBook)
            {
                <br />
                <a class="alert-link-btn" asp-controller="Appointments" asp-action="Book" asp-route-applicationId="@Model.Id">
                    <i class="fas fa-calendar-check"></i> Book a new appointment
                </a>
            }
        </div>
    </div>
}
else if (Model.Status == ApplicationStatus.Rejected && !string.IsNullOrEmpty(Model.Remarks))
{
    <div class="det-alert det-alert-danger">
        <div class="det-alert-icon"><i class="fas fa-times-circle"></i></div>
        <div>
            <strong>Remarks</strong>
            @Model.Remarks
        </div>
    </div>
}

<!-- HUSBAND / WIFE -->
<div class="person-grid">
    <div class="det-card mb-0">
        <div class="det-card-header"><i class="fas fa-male me-2"></i>Husband</div>
        <ul class="info-list">
            <li><strong>Full name</strong>@Model.HusbandName</li>
            <li><strong>Mother name</strong>@Show(Model.HusbandMotherName)</li>
            <li><strong>Date of birth</strong>@Model.HusbandDob.ToString("yyyy-MM-dd")</li>
            <li><strong>National ID</strong>@Model.HusbandIdNumber</li>
            <li><strong>Address (Residence)</strong>@Model.HusbandAddress</li>
            <li><strong>Occupation</strong>@Show(Model.HusbandOccupation)</li>
            <li><strong>Marital status</strong>@Show(Model.HusbandMaritalStatus)</li>
            <li><strong>Religion</strong>@Show(Model.HusbandReligion)</li>
            <li><strong>Contact</strong>@Show(Model.HusbandContactNumber)</li>
            @if (Doc(DocumentCategories.HusbandIdentityDocument) != null)
            {
                <li>
                    <strong>ID / Passport</strong>
                    <a target="_blank" class="det-link" href="~/@Doc(DocumentCategories.HusbandIdentityDocument)!.FilePath">
                        <i class="fas fa-file-alt me-1"></i>View document
                    </a>
                </li>
            }
        </ul>
    </div>
    <div class="det-card mb-0">
        <div class="det-card-header"><i class="fas fa-female me-2"></i>Wife</div>
        <ul class="info-list">
            <li><strong>Full name</strong>@Model.WifeName</li>
            <li><strong>Mother name</strong>@Show(Model.WifeMotherName)</li>
            <li><strong>Date of birth</strong>@Model.WifeDob.ToString("yyyy-MM-dd")</li>
            <li><strong>National ID</strong>@Model.WifeIdNumber</li>
            <li><strong>Address (Residence)</strong>@Model.WifeAddress</li>
            <li><strong>Occupation</strong>@Show(Model.WifeOccupation)</li>
            <li><strong>Marital status</strong>@Show(Model.WifeMaritalStatus)</li>
            <li><strong>Religion</strong>@Show(Model.WifeReligion)</li>
            <li><strong>Contact</strong>@Show(Model.WifeContactNumber)</li>
            @if (Doc(DocumentCategories.WifeIdentityDocument) != null)
            {
                <li>
                    <strong>ID / Passport</strong>
                    <a target="_blank" class="det-link" href="~/@Doc(DocumentCategories.WifeIdentityDocument)!.FilePath">
                        <i class="fas fa-file-alt me-1"></i>View document
                    </a>
                </li>
            }
        </ul>
    </div>
</div>

<!-- WITNESSES -->
@if (Model.Witnesses.Any())
{
    <div class="det-card">
        <div class="det-card-header"><i class="fas fa-users me-2"></i>Witnesses (Markhaatiyaal)</div>
        <div class="det-card-body">
            <div class="witness-grid">
                @foreach (var w in Model.Witnesses.OrderBy(x => x.SortOrder))
                {
                    <div>
                        <p class="witness-label">Witness @w.SortOrder</p>
                        <ul class="witness-fields">
                            <li><strong>Full name</strong>@w.FullName</li>
                            <li><strong>Mother name</strong>@Show(w.MotherName)</li>
                            <li><strong>Date of birth</strong>@w.DateOfBirth.ToString("yyyy-MM-dd")</li>
                            <li><strong>National ID</strong>@w.IdNumber</li>
                            <li><strong>Contact</strong>@Show(w.ContactNumber)</li>
                            <li><strong>Address</strong>@w.Address</li>
                            @{
                                var witnessDoc = w.SortOrder == 1
                                ? Doc(DocumentCategories.Witness1IdentityDocument)
                                : Doc(DocumentCategories.Witness2IdentityDocument);
                            }
                            @if (witnessDoc != null)
                            {
                                <li>
                                    <strong>ID / Passport</strong>
                                    <a target="_blank" class="det-link" href="~/@witnessDoc.FilePath">
                                        <i class="fas fa-file-alt me-1"></i>View document
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- CEREMONY -->
<div class="det-card">
    <div class="det-card-header"><i class="fas fa-mosque me-2"></i>Ceremony</div>
    <div class="det-card-body">
        <p class="det-row"><strong>Marriage date:</strong> @Model.MarriageDate.ToString("yyyy-MM-dd")</p>
        <p class="det-row"><strong>Marriage location:</strong> @Model.MarriageLocation</p>
        <p class="det-row"><strong>District:</strong> @Show(Model.District)</p>
        <p class="det-row"><strong>Sheikh name (Officiant):</strong> @Show(Model.SheikhName)</p>
        <p class="det-row"><strong>Meher type:</strong> @Show(Model.MarriageType)</p>
        <p class="det-row"><strong>Meher:</strong> @Show(Model.Meher)</p>
        <p class="det-muted mt-2 mb-0">Submitted @Model.SubmissionDate.ToString("yyyy-MM-dd HH:mm") UTC</p>
    </div>
</div>

<!-- DOCUMENTS -->
@if (Model.Documents.Any())
{
    <div class="det-card">
        <div class="det-card-header"><i class="fas fa-folder-open me-2"></i>Uploaded documents</div>
        <ul class="doc-list">
            @foreach (var d in Model.Documents.OrderBy(x => DocumentCategories.SortOrder(x.Category)).ThenBy(x => x.Id))
            {
                <li>
                    <span class="doc-icon"><i class="fas fa-file"></i></span>
                    <strong class="me-1">@DocumentCategories.DisplayName(d.Category)</strong>
                    <span class="det-muted">—</span>
                    <a target="_blank" class="det-link" href="~/@d.FilePath">@System.IO.Path.GetFileName(d.FilePath)</a>
                </li>
            }
        </ul>
    </div>
}

<a asp-action="Index" class="btn-back-link"><i class="fas fa-arrow-left"></i> Back to list</a>
