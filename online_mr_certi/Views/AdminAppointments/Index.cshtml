@model List<online_mr_certi.Models.ViewModels.StaffVerificationRow>
@using online_mr_certi.Models
@{
    ViewData["Title"] = "All Appointments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<section class="content-header">
    <div class="container-fluid">
        <h1>All Appointments</h1>
    </div>
</section>
<section class="content">
    <div class="container-fluid">
        <p class="mb-3">
            <a asp-action="ScheduleSettings" class="btn btn-default">Schedule settings</a>
            <a asp-action="Verification" class="btn btn-info">Staff verification</a>
        </p>
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Reference</th>
                            <th>Time</th>
                            <th>Applicant</th>
                            <th>Husband / Wife</th>
                            <th>Appt. Status</th>
                            <th>App. Status</th>
                            <th>Payment</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No appointments found.</td></tr>
                        }
                        @foreach (var row in Model)
                        {
                            <tr>
                                <td>@row.AppointmentDateLabel</td>
                                <td><code>@row.ReferenceNumber</code></td>
                                <td>@row.TimeLabel</td>
                                <td>@row.ApplicantName</td>
                                <td>@row.HusbandName / @row.WifeName</td>
                                <td>
                                    @if (row.AppointmentStatus == AppointmentStatuses.Booked)
                                    { <span class="badge badge-warning">Booked</span> }
                                    else if (row.AppointmentStatus == AppointmentStatuses.Confirmed)
                                    { <span class="badge badge-info">Confirmed</span> }
                                    else if (row.AppointmentStatus == AppointmentStatuses.Completed)
                                    { <span class="badge badge-success">Completed</span> }
                                    else if (row.AppointmentStatus == AppointmentStatuses.Cancelled)
                                    { <span class="badge badge-danger">Cancelled</span> }
                                    else
                                    { <span class="text-muted">@row.AppointmentStatus</span> }
                                </td>
                                <td>@row.ApplicationStatus</td>
                                <td>@row.PaymentStatus</td>
                                <td>
                                    <a asp-controller="Admin" asp-action="ApplicationDetails" asp-route-id="@row.ApplicationId" class="btn btn-sm btn-primary">Open</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
