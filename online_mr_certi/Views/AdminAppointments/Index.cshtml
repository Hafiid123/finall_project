@model List<online_mr_certi.Models.ViewModels.StaffVerificationRow>
@{
    ViewData["Title"] = "Appointments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var selected = (DateOnly)ViewBag.SelectedDate;
}
<section class="content-header">
    <div class="container-fluid">
        <h1>Appointments — @selected.ToString("dddd, dd MMM yyyy")</h1>
    </div>
</section>
<section class="content">
    <div class="container-fluid">
        <form method="get" class="form-inline mb-3">
            <label class="mr-2">Date</label>
            <input type="date" name="date" class="form-control mr-2" value="@selected.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary">Show</button>
            <a asp-action="ScheduleSettings" class="btn btn-default ml-2">Schedule settings</a>
            <a asp-action="Verification" asp-route-date="@selected.ToString("yyyy-MM-dd")" class="btn btn-info ml-2">Staff verification</a>
        </form>
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Time</th>
                            <th>Applicant</th>
                            <th>Husband / Wife</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No appointments for this date.</td></tr>
                        }
                        @foreach (var row in Model)
                        {
                            <tr>
                                <td><code>@row.ReferenceNumber</code></td>
                                <td>@row.TimeLabel</td>
                                <td>@row.ApplicantName</td>
                                <td>@row.HusbandName / @row.WifeName</td>
                                <td>@row.ApplicationStatus</td>
                                <td>@row.PaymentStatus</td>
                                <td>
                                    <a asp-controller="Admin" asp-action="ApplicationDetails" asp-route-id="@row.ApplicationId" class="btn btn-sm btn-primary">Open</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
