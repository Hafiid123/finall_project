@model online_mr_certi.Models.ViewModels.BookAppointmentViewModel
@{
    ViewData["Title"] = "Book appointment";
}
<h2 class="h4 mb-3">Book office appointment</h2>
<p class="text-muted small">Application #@Model.ApplicationId — an appointment is required before your visit.</p>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form asp-action="Book" method="post" id="bookForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ApplicationId" />

            <div class="mb-3">
                <label asp-for="SelectedDate" class="form-label"></label>
                <select asp-for="SelectedDate" class="form-select" id="dateSelect" required>
                    <option value="">— Select date —</option>
                    @foreach (var d in Model.AvailableDates)
                    {
                        <option value="@d.ToString("yyyy-MM-dd")" selected="@(Model.SelectedDate == d)">@d.ToString("dddd, dd MMM yyyy")</option>
                    }
                </select>
            </div>

            <div class="mb-3" id="slotSection" style="@(Model.Slots.Count == 0 ? "display:none" : "")">
                <label class="form-label">Time slot</label>
                @if (Model.Slots.Count == 0)
                {
                    <p class="text-muted small mb-0" id="slotPlaceholder">Select a date to see available time slots.</p>
                }
                <div id="slotList">
                    @foreach (var slot in Model.Slots)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="TimeSlotId" id="slot_@slot.TimeSlotId"
                                   value="@slot.TimeSlotId" @(slot.IsAvailable ? "" : "disabled")
                                   @(Model.TimeSlotId == slot.TimeSlotId ? "checked" : "") />
                            <label class="form-check-label @(slot.IsAvailable ? "" : "text-muted")" for="slot_@slot.TimeSlotId">
                                @slot.Label
                                @if (slot.IsAvailable)
                                {
                                    <span class="badge text-bg-success ms-1">@slot.Remaining left</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary ms-1">Full</span>
                                }
                            </label>
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Confirm appointment</button>
            <a asp-controller="Applications" asp-action="Details" asp-route-id="@Model.ApplicationId" class="btn btn-outline-secondary ms-2">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('dateSelect')?.addEventListener('change', function () {
            var val = this.value;
            if (!val) return;
            window.location.href = '@Url.Action("Slots")?applicationId=@Model.ApplicationId&date=' + val;
        });
    </script>
}
