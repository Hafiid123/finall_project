@model online_mr_certi.Models.MarriageApplication
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shahaadada Meherka - @Model.Id</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
        }

        @@media print {
            @@page {
                size: A4 portrait;
                margin: 0;
            }

            body {
                margin: 0 !important;
                padding: 0 !important;
                background-color: navajowhite;
            }

            .no-print {
                display: none !important;
            }

            .print-page {
                width: 210mm;
                height: 297mm;
                padding: 10mm 15mm !important;
                margin: 0 !important;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }
        }

        .print-page {
            width: 210mm;
            min-height: 297mm;
            margin: 10px auto;
            padding: 15mm;
            background: white;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        }</style>

    <style>
        .formal-number {
            font-weight: bold;
            font-variant-numeric: tabular-nums;
            direction: ltr;
            unicode-bidi: isolate;
        }
    </style>
</head>
<body class="bg-gray-100 antialiased p-0 m-0">

    <div class="no-print max-w-4xl mx-auto my-4 px-4 flex justify-between items-center">
        @{
            var userRole = Context.Session.GetString("Role");
        }

        @if (userRole == "Admin" || userRole == "Staff")
        {
            <a href="@Url.Action("Applications", "Admin")" class="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded shadow text-sm font-sans flex items-center gap-1">
                ⬅️ Ku laabo liiska
            </a>
        }
        else
        {
            <a href="@Url.Action("Index", "Applications")" class="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded shadow text-sm font-sans flex items-center gap-1">
                ⬅️ Ku laabo liiska
            </a>
        }
        <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded shadow font-sans font-bold flex items-center gap-2 cursor-pointer">
            🖨️ Daabac Shahaadada
        </button>
    </div>

    <div class="print-page max-w-[210mm] min-h-[297mm] mx-auto bg-white px-16 py-12 relative my-6 flex flex-col justify-between select-none">

        <div class="absolute inset-0 flex items-center justify-center opacity-[0.09] pointer-events-none">
            <img src="~/uniso2.png" class="w-[600px] h-[600px] object-contain" />
        </div>

        <div class="w-full flex flex-col justify-between h-full min-h-[265mm] relative z-10">

            <div class="text-center relative pt-4">

                <div class="grid grid-cols-3 items-center text-[11px] font-bold text-gray-900 px-2 font-serif">

                    <div class="text-left leading-[1.5] tracking-wide">
                        JAAMACADA SOOMAALIYA UNISO<br>
                        MAXKAMADA JAMACADA SOMALIA <br />
                        MUQDISHO - SOMALIA
                    </div>

                    <div class="flex justify-center items-center h-20">
                        <img src="~/uniso2.png" alt="Calamada Qaranka" class="w-35 h-20 object-contain">
                    </div>

                    <div class="text-right leading-[1.5] font-sans tracking-wide text-[15px]" dir="rtl">
                        جامعة الصومال <br />
                        محكمة جامعة الصومال
                    </div>
                </div>

                <div class="mt-2 text-center">
                    <p class="text-[13px] font-bold text-gray-950 tracking-[0.05em] font-serif">UNIVERSITY OF SOMALIA UNISO</p>
                    <p class="text-[11px] text-gray-800 font-semibold tracking-wide uppercase mt-0.5 font-serif">UNIVERSITY OF SOMALIA COURT </p>
                    <p class="text-[11px] text-gray-800 font-semibold tracking-wide uppercase mt-0.5 font-serif">MOGADISHU-SOMALIA</p>
                </div>

                <div class="w-full h-1.5 mt-4 opacity-90" style="border-bottom:3px solid #8B0000; border-top:4px solid #00DF82;"></div>



                <div class="flex justify-between items-center mt-6 text-[14px] font-serif px-2">
                    <div class="text-left">
                        @* <p class="text-gray-500 text-[8.5px] uppercase tracking-wider font-bold">Lambarka Codsiga</p> *@
                        <p class="text-black mt-1 font-bold">
                            Summ:
                            <span style="font-family: 'Times New Roman', Times, serif; font-weight: 800; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">
                                UNISO/FCS/0@(Model.Id)/@DateTime.Now.ToString("yyyy")
                            </span>
                        </p>
                    </div>
                    <div class="text-right">
                        @* <p class="text-gray-500 text-[8.5px] uppercase tracking-wider font-bold">Lambarka Shahaadada</p> *@
                        <p class="text-black mt-1 font-bold">
                            Tr:
                            <span style="font-family: 'Times New Roman', Times, serif; font-weight: 800; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">
                                @DateTime.Now.ToString("dd/MM/yyyy")
                            </span>
                        </p>
                    </div>
                </div>


                <div class="mt-6 px-2">
                    <p class="text-[17px] font-bold font-serif text-black tracking-widest mt-1">
                        SHAHAADA NIKAAX
                    </p>

                    <p class="text-[14px] text-black font-bold font-serif tracking-wide mt-1 text-left">
                        Maxkamadu waxey sugaysaa in dadka kala ah:
                    </p>
                </div>




                <div class="my-6 text-[14px] text-gray-900 leading-[2] text-justify font-serif px-2 space-y-3">
                    <p>
                        Magaca Ninka: <strong class="text-black font-bold">@Model.HusbandName</strong>, ina <span class="font-normal">@Model.HusbandMotherName</span>, dhashay: <span style="font-family: 'Times New Roman', Times, serif; font-weight: bold; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">
                            @Model.HusbandDob.ToString("dd/MM/yyyy")</span>,<br />
                        leh Aqoonsi No <span style="font-family: 'Times New Roman', Times, serif; font-weight: bold; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">@Model.HusbandIdNumber</span>, shaqada: <strong class="text-black font-bold">@Model.HusbandOccupation</strong>, Xaalad guur hore: <strong class="text-black font-bold">@Model.HusbandMaritalStatus</strong>,<br />
                        deggan <strong class="text-black font-bold">@Model.HusbandAddress</strong>, diinta: <strong class="text-black font-bold">@Model.HusbandReligion</strong>
                    </p>

                    <p>
                        Magaca Xaaska: <strong class="text-black font-bold">@Model.WifeName</strong>, ina <span class="font-normal">@Model.WifeMotherName</span>, dhalatay: <span style="font-family: 'Times New Roman', Times, serif; font-weight: bold; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">
                            @Model.WifeDob.ToString("dd/MM/yyyy")</span>,<br />
                        leh Baasaboor No <span style="font-family: 'Times New Roman', Times, serif; font-weight: bold; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">@Model.WifeIdNumber</span>, Shaqada: <strong class="text-black font-bold">@Model.WifeOccupation</strong>, Xaalad guur hore: <strong class="text-black font-bold">@Model.WifeMaritalStatus</strong>,<br />
                        deggan: <strong class="text-black font-bold">@Model.WifeAddress</strong>, diinta: <strong class="text-black font-bold">@Model.WifeReligion</strong>.
                    </p>

                    <p>
                        ay isku guursadeen si waafaqsan: Shareecada Islaamka Garsoore/wakiil ruqsad haysta
                        hortiisa Sheekh: <strong class="text-black font-bold">@Model.SheikhName</strong> taariikhda: <span style="font-family: 'Times New Roman', Times, serif; font-weight: bold; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">
                            @Model.MarriageDate.ToString("dd/MM/yyyy")</span> Goobta: <strong class="text-black font-bold">@Model.MarriageLocation</strong>@if (!string.IsNullOrWhiteSpace(Model.District)) { <text>, Degmada: <strong class="text-black font-bold">@Model.District</strong></text> },
                        Nooca meherka: <strong class="text-black font-bold">@Model.MarriageType</strong>, Qiimaha: <span style="font-family: 'Times New Roman', Times, serif; font-weight: bold; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">@Model.Meher</span>, marqaati ay ka ahaayeen.


                        <br />
                        <br />
                   

                    @if (!string.IsNullOrWhiteSpace(Model.Witness1Name))
                    {
                        <p>
                        <span style="font-family: 'Times New Roman', Times, serif; font-weight: bold; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">
                            1.</span>
                            <strong class="text-black font-bold">@Model.Witness1Name</strong>,
                            ina <span class="font-normal">@Model.Witness1MotherName</span>
                            dhashay
                            <span style="font-family: 'Times New Roman', Times, serif; font-weight: 850; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">
                                @Model.Witness1DateOfBirth?.ToString("dd/MM/yyyy")
                            </span>,
                            leh <br /> aqoonsi lambar
                            <span style="font-family: 'Times New Roman', Times, serif; font-weight: 1000; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">
                                @Model.Witness1IdNumber
                            </span>
                            degan <span class="font-normal">@Model.Witness1Address</span>
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Witness2Name))
                    {
                        <p>
                            <span style="font-family: 'Times New Roman', Times, serif; font-weight: bold; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">
                                2.
                            </span>
                            <strong class="text-black font-bold">@Model.Witness2Name</strong>,
                            ina <span class="font-normal">@Model.Witness2MotherName</span>,
                            dhashay
                            <span style="font-family: 'Times New Roman', Times, serif; font-weight: 800; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">
                                @Model.Witness2DateOfBirth?.ToString("dd/MM/yyyy")
                            </span>,
                            leh <br /> aqoonsi lambar
                            <span style="font-family: 'Times New Roman', Times, serif; font-weight: 800; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;">
                                @Model.Witness2IdNumber
                            </span>
                            degan <span class="font-normal">@Model.Witness2Address</span>
                        </p>
                    }


                    <div class="mt-6 px-2 text-center">
                        
                        <p class="text-[14px] text-black font-bold font-serif tracking-wide mt-1 inline-block">
                            Garsooraha Maxkamada Jaamacada Uniso
                        </p>

                        <p class="text-[14px] text-black font-bold font-serif tracking-wide mt-1 inline-block">
                            Eng. Abdirahman Mohamed Salad
                        </p>

                    </div>



                </div>



            </div>

            <div class="w-full h-1.5 mt-4 opacity-90" style="border-bottom:4px solid #8B0000; border-top:1px solid #8B0000;">

                <p class="text-[12px] font-serif text-center mt-2">Uniso Court, Howlwadaag - Cs Secion , Mogadishu-Somalia, TELL: 61XXXXX</p>
            </div>




            @*  <div class="flex flex-col items-center justify-center pb-1">
                    <div class="w-[72px] h-[72px] border-2 border-blue-800/30 border-dashed rounded-full flex flex-col items-center justify-center text-blue-800/40 text-[8px] font-bold p-1 uppercase">
                        <span>Official</span>
                        <span>Stamp</span>
                    </div>
                    <p class="text-[9px] font-bold text-gray-700 mt-2 tracking-wider">CIVIL REGISTRATION</p>
                </div> *@

            @* <div class="text-right pr-2">
                    <div class="h-10 flex items-end justify-end mb-1">
                        <p class="font-serif italic text-base font-bold text-gray-900 tracking-wider">@Model.HusbandName</p>
                    </div>
                    <div class="w-full h-[1px] bg-gray-400 my-1"></div>
                    <p class="font-bold text-gray-900 text-[9.5px] uppercase tracking-tight">Director General Civil Registry</p>
                    <p class="text-[8.5px] text-gray-500 italic mt-0.5">Taariikhda: @DateTime.Now.ToString("dd-MMM-yyyy")</p>
                </div> *@
        </div>

    </div>
    </div>

</body>
</html>
