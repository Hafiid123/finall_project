@model online_mr_certi.Models.ViewModels.AdminCreateApplicationViewModel
@using online_mr_certi.Models
@{
    ViewData["Title"] = "New Marriage Application";
}

<form asp-action="CreateApplication" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="icon fas fa-ban"></i> Please fix the errors below.
    </div>

    <div class="card card-outline card-primary mb-3">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-user-circle mr-1"></i> Applicant Account
            </h3>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label asp-for="UserId" class="font-weight-bold">
                    Select Registered Applicant (Optional)
                </label>
                <select asp-for="UserId" class="form-control">
                    <option value="">-- No Account / Guest Applicant --</option>
                    @if (ViewBag.Users != null)
                    {
                        foreach (var user in ViewBag.Users)
                        {
                            <option value="@user.Id">@user.Name — @user.Email</option>
                        }
                    }
                </select>
                <span asp-validation-for="UserId" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="card card-outline card-info mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-male mr-1"></i> Husband (Ninka)</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="HusbandName"></label>
                        <input asp-for="HusbandName" class="form-control" placeholder="Full name" />
                        <span asp-validation-for="HusbandName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="HusbandMotherName"></label>
                        <input asp-for="HusbandMotherName" class="form-control" placeholder="Mother name" />
                        <span asp-validation-for="HusbandMotherName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="HusbandDob"></label>
                        <input asp-for="HusbandDob" class="form-control" type="date" />
                        <span asp-validation-for="HusbandDob" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="HusbandIdNumber"></label>
                        <input asp-for="HusbandIdNumber" class="form-control" placeholder="National ID number" />
                        <span asp-validation-for="HusbandIdNumber" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="HusbandOccupation"></label>
                        <input asp-for="HusbandOccupation" class="form-control" placeholder="Occupation" />
                        <span asp-validation-for="HusbandOccupation" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-group">
                        <label asp-for="HusbandAddress"></label>
                        <textarea asp-for="HusbandAddress" class="form-control" rows="2" placeholder="Address (Residence)"></textarea>
                        <span asp-validation-for="HusbandAddress" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="HusbandMaritalStatus"></label>
                        <select asp-for="HusbandMaritalStatus" class="form-control">
                            <option value="">—</option>
                            <option value="Guursaday">Guursaday</option>
                            <option value="MaGuursan">Ma guursan</option>
                        </select>
                        <span asp-validation-for="HusbandMaritalStatus" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="HusbandReligion"></label>
                        <input asp-for="HusbandReligion" class="form-control" placeholder="Religion" />
                        <span asp-validation-for="HusbandReligion" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="HusbandContactNumber"></label>
                        <input asp-for="HusbandContactNumber" class="form-control" placeholder="Contact number" />
                        <span asp-validation-for="HusbandContactNumber" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-12">
                    <hr />
                    <p class="text-muted mb-2"><i class="fas fa-paperclip mr-1"></i> Husband — document</p>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label asp-for="HusbandIdentityDocument"></label>
                        <div class="custom-file">
                            <input asp-for="HusbandIdentityDocument" type="file" class="custom-file-input"
                                   accept=".pdf,.jpg,.jpeg,.png,.webp" id="hIdDoc" />
                            <label class="custom-file-label" for="hIdDoc">Choose file…</label>
                        </div>
                        <span asp-validation-for="HusbandIdentityDocument" class="text-danger small"></span>
                        <p class="form-text mb-0">National ID or passport — PDF or image. Max 10 MB.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-outline card-warning mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-female mr-1"></i> Wife (Xaaska)</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="WifeName"></label>
                        <input asp-for="WifeName" class="form-control" placeholder="Full name" />
                        <span asp-validation-for="WifeName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="WifeMotherName"></label>
                        <input asp-for="WifeMotherName" class="form-control" placeholder="Mother name" />
                        <span asp-validation-for="WifeMotherName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="WifeDob"></label>
                        <input asp-for="WifeDob" class="form-control" type="date" />
                        <span asp-validation-for="WifeDob" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="WifeIdNumber"></label>
                        <input asp-for="WifeIdNumber" class="form-control" placeholder="National ID number" />
                        <span asp-validation-for="WifeIdNumber" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="WifeOccupation"></label>
                        <input asp-for="WifeOccupation" class="form-control" placeholder="Occupation" />
                        <span asp-validation-for="WifeOccupation" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-group">
                        <label asp-for="WifeAddress"></label>
                        <textarea asp-for="WifeAddress" class="form-control" rows="2" placeholder="Address (Residence)"></textarea>
                        <span asp-validation-for="WifeAddress" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="WifeMaritalStatus"></label>
                        <select asp-for="WifeMaritalStatus" class="form-control">
                            <option value="">— Select —</option>
                            <option value="Guursatay">Guursatay</option>
                            <option value="MaGuursan">Ma guursan</option>
                        </select>
                        <span asp-validation-for="WifeMaritalStatus" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="WifeReligion"></label>
                        <input asp-for="WifeReligion" class="form-control" placeholder="Religion" />
                        <span asp-validation-for="WifeReligion" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="WifeContactNumber"></label>
                        <input asp-for="WifeContactNumber" class="form-control" placeholder="Contact number" />
                        <span asp-validation-for="WifeContactNumber" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-12">
                    <hr />
                    <p class="text-muted mb-2"><i class="fas fa-paperclip mr-1"></i> Wife — document</p>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label asp-for="WifeIdentityDocument"></label>
                        <div class="custom-file">
                            <input asp-for="WifeIdentityDocument" type="file" class="custom-file-input"
                                   accept=".pdf,.jpg,.jpeg,.png,.webp" id="wIdDoc" />
                            <label class="custom-file-label" for="wIdDoc">Choose file…</label>
                        </div>
                        <span asp-validation-for="WifeIdentityDocument" class="text-danger small"></span>
                        <p class="form-text mb-0">National ID or passport — PDF or image. Max 10 MB.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-outline card-success mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-ring mr-1"></i> Marriage Information</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MarriageDate"></label>
                        <input asp-for="MarriageDate" class="form-control" type="date" />
                        <span asp-validation-for="MarriageDate" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MarriageLocation"></label>
                        <input asp-for="MarriageLocation" class="form-control" placeholder="Marriage location" />
                        <span asp-validation-for="MarriageLocation" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="District"></label>
                        <input asp-for="District" class="form-control" placeholder="District" />
                        <span asp-validation-for="District" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="SheikhName"></label>
                        <input asp-for="SheikhName" class="form-control" placeholder="Sheikh name (Officiant)" />
                        <span asp-validation-for="SheikhName" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-outline card-secondary mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-gift mr-1"></i> Meher (Mahr)</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-md-0">
                        <label asp-for="MeherType"></label>
                        <select asp-for="MeherType" asp-items="Html.GetEnumSelectList<MeherType>()" class="form-control">
                            <option value="">— Select —</option>
                        </select>
                        <span asp-validation-for="MeherType" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label asp-for="Meher"></label>
                        <input asp-for="Meher" class="form-control" placeholder="e.g. 5000 USD or 100 gram gold" />
                        <span asp-validation-for="Meher" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card card-outline card-secondary mb-3">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-user-check mr-1"></i> Witness 1</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="collapse">
                            <i class="fas fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label asp-for="Witness1.FullName"></label>
                        <input asp-for="Witness1.FullName" class="form-control" placeholder="Full name" />
                        <span asp-validation-for="Witness1.FullName" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Witness1.MotherName"></label>
                        <input asp-for="Witness1.MotherName" class="form-control" placeholder="Mother name" />
                        <span asp-validation-for="Witness1.MotherName" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Witness1.DateOfBirth"></label>
                        <input asp-for="Witness1.DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="Witness1.DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Witness1.IdNumber"></label>
                        <input asp-for="Witness1.IdNumber" class="form-control" placeholder="National ID number" />
                        <span asp-validation-for="Witness1.IdNumber" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Witness1.ContactNumber"></label>
                        <input asp-for="Witness1.ContactNumber" class="form-control" placeholder="Contact number" />
                        <span asp-validation-for="Witness1.ContactNumber" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Witness1.Address"></label>
                        <textarea asp-for="Witness1.Address" class="form-control" rows="2" placeholder="Address"></textarea>
                        <span asp-validation-for="Witness1.Address" class="text-danger small"></span>
                    </div>
                    <hr />
                    <div class="form-group mb-0">
                        <label asp-for="Witness1IdentityDocument"></label>
                        <div class="custom-file">
                            <input asp-for="Witness1IdentityDocument" type="file" class="custom-file-input"
                                   accept=".pdf,.jpg,.jpeg,.png,.webp" id="w1Doc" />
                            <label class="custom-file-label" for="w1Doc">Choose file…</label>
                        </div>
                        <span asp-validation-for="Witness1IdentityDocument" class="text-danger small"></span>
                        <p class="form-text mb-0">National ID or passport — PDF or image.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card card-outline card-secondary mb-3">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-user-check mr-1"></i> Witness 2</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="collapse">
                            <i class="fas fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label asp-for="Witness2.FullName"></label>
                        <input asp-for="Witness2.FullName" class="form-control" placeholder="Full name" />
                        <span asp-validation-for="Witness2.FullName" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Witness2.MotherName"></label>
                        <input asp-for="Witness2.MotherName" class="form-control" placeholder="Mother name" />
                        <span asp-validation-for="Witness2.MotherName" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Witness2.DateOfBirth"></label>
                        <input asp-for="Witness2.DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="Witness2.DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Witness2.IdNumber"></label>
                        <input asp-for="Witness2.IdNumber" class="form-control" placeholder="National ID number" />
                        <span asp-validation-for="Witness2.IdNumber" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Witness2.ContactNumber"></label>
                        <input asp-for="Witness2.ContactNumber" class="form-control" placeholder="Contact number" />
                        <span asp-validation-for="Witness2.ContactNumber" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Witness2.Address"></label>
                        <textarea asp-for="Witness2.Address" class="form-control" rows="2" placeholder="Address"></textarea>
                        <span asp-validation-for="Witness2.Address" class="text-danger small"></span>
                    </div>
                    <hr />
                    <div class="form-group mb-0">
                        <label asp-for="Witness2IdentityDocument"></label>
                        <div class="custom-file">
                            <input asp-for="Witness2IdentityDocument" type="file" class="custom-file-input"
                                   accept=".pdf,.jpg,.jpeg,.png,.webp" id="w2Doc" />
                            <label class="custom-file-label" for="w2Doc">Choose file…</label>
                        </div>
                        <span asp-validation-for="Witness2IdentityDocument" class="text-danger small"></span>
                        <p class="form-text mb-0">National ID or passport — PDF or image.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body d-flex justify-content-between">
            <a asp-action="Applications" class="btn btn-secondary">
                <i class="fas fa-arrow-left mr-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary btn-lg px-5">
                <i class="fas fa-save mr-1"></i> Submit Application
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.custom-file-input').forEach(function (input) {
            input.addEventListener('change', function () {
                var label = this.nextElementSibling;
                label.textContent = this.files.length === 1
                    ? this.files[0].name
                    : this.files.length + ' files selected';
            });
        });
    </script>
}
